```gitignore
# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
venv/
env/
.venv/
ENV/

# Environment variables and secrets
.env
.env.*
!.env.example

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# Testing and coverage
.coverage
htmlcov/
.pytest_cache/
.tox/

# Migrations
# Keep Django migrations tracked in Git.
# Do not ignore migrations folders.

# IDE and editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Build and distribution
build/
dist/
*.egg-info/

# Node.js (if used for frontend tooling)
node_modules/
npm-debug.log*
yarn-debug.log*
